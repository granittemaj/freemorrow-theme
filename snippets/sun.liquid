{%- comment -%}
  The striped sun from the logo: a solid dome, then bands that thin towards the horizon.
  Accepts: id {String} a unique id for its clip path
{%- endcomment -%}
<svg viewBox="0 0 100 77" aria-hidden="true" focusable="false"><defs><clipPath id="{{ id }}"><circle cx="50" cy="50" r="50"/></clipPath></defs><g clip-path="url(#{{ id }})" fill="#C9432A"><rect x="0" y="0" width="100" height="41"/><rect x="0" y="45" width="100" height="5.2"/><rect x="0" y="53.6" width="100" height="4.4"/><rect x="0" y="61.2" width="100" height="3.6"/><rect x="0" y="67.6" width="100" height="2.8"/><rect x="0" y="73.2" width="100" height="2.2"/></g></svg>

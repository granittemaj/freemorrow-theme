{%- comment -%} Switches every size table on the page between inches and centimetres (theme.js). {%- endcomment -%}
<div class="seg units" role="group" aria-label="{{ 'size_guide.units' | t }}">
  <button type="button" data-unit="in" aria-pressed="true">{{ 'size_guide.in' | t }}</button>
  <button type="button" data-unit="cm" aria-pressed="false">{{ 'size_guide.cm_short' | t }}</button>
</div>

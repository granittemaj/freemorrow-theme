<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="theme-color" content="#EAE3D5">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- comment -%} The striped sun, unless a favicon is chosen in Theme settings › Logo. {%- endcomment -%}
  {%- if settings.favicon != blank -%}
    <link rel="icon" type="image/png" sizes="32x32" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
  {%- else -%}
    <link rel="icon" type="image/svg+xml" href="{{ 'favicon.svg' | asset_url }}">
    <link rel="icon" type="image/png" sizes="32x32" href="{{ 'favicon-32.png' | asset_url }}">
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
  {%- endif -%}
  {%- liquid
    assign meta_description = page_description | default: settings.seo_description
    assign is_policy = false
    if request.page_type == 'policy'
      assign is_policy = true
    endif
  -%}
  <title>
    {{- page_title -}}
    {%- if request.page_type == 'index' and page_title == shop.name and settings.seo_home_tagline != blank %} &ndash; {{ settings.seo_home_tagline }}{% endif -%}
    {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags.first }}{% endif -%}
    {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
    {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
  </title>
  {% render 'meta-tags', description: meta_description %}
  {% render 'structured-data' %}
  {{ 'font-geist-normal-latin-2.woff2' | asset_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
  {{ 'fonts.css' | asset_url | stylesheet_tag }}

  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ 'story.css' | asset_url | stylesheet_tag }}
  {{ 'pages.css' | asset_url | stylesheet_tag }}
  {{ 'theme.css' | asset_url | stylesheet_tag }}

  <script>
    document.documentElement.classList.add('js');
    window.FM = window.FM || {};
    FM.moneyFormat = {{ shop.money_format | json }};
    FM.routes = {
      cart: {{ routes.cart_url | json }},
      cartAdd: {{ routes.cart_add_url | json }},
      cartChange: {{ routes.cart_change_url | json }},
      root: {{ routes.root_url | json }}
    };
    FM.strings = {
      addToBag: {{ 'products.product.add_to_cart' | t | json }},
      soldOut: {{ 'products.product.sold_out' | t | json }},
      chooseSize: {{ 'products.product.choose_size' | t | json }},
      added: {{ 'products.product.added' | t | json }},
      empty: {{ 'cart.empty' | t | json }},
      emptyLine: {{ 'cart.empty_line' | t | json }},
      remove: {{ 'cart.remove' | t | json }},
      error: {{ 'cart.error' | t | json }},
      searchEmpty: {{ 'search.none' | t | json }},
      searchAll: {{ 'search.see_all' | t | json }},
      inches: {{ 'size_guide.inches' | t | json }},
      cm: {{ 'size_guide.cm' | t | json }},
      cookiesSaved: {{ 'cookies.saved' | t | json }},
      viewFront: {{ 'products.turn.front' | t | json }},
      viewBack: {{ 'products.turn.back' | t | json }},
      viewLeft: {{ 'products.turn.left' | t | json }},
      viewRight: {{ 'products.turn.right' | t | json }},
      viewLeftFront: {{ 'products.turn.left_front' | t | json }},
      viewRightFront: {{ 'products.turn.right_front' | t | json }},
      turnLeft: {{ 'products.turn.turn_left' | t | json }},
      turnRight: {{ 'products.turn.turn_right' | t | json }},
      dragToTurn: {{ 'products.turn.drag' | t | json }},
      turntable: {{ 'products.turn.label' | t | json }}
    };
    FM.searchUrl = {{ routes.predictive_search_url | json }};
    FM.cookies = {{ settings.cookie_banner | json }} ? { everyone: {{ settings.cookie_everyone | json }} } : null;
  </script>
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
  {%- comment -%} The scroll-led pages animate with GSAP; it loads only where it is used. {%- endcomment -%}
  {%- if template.name == 'index' or template.name == 'collection' or template.suffix == 'about' -%}
    <script src="{{ 'gsap.min.js' | asset_url }}" defer></script>
    <script src="{{ 'gsap-scrolltrigger.min.js' | asset_url }}" defer></script>
  {%- endif -%}
  {%- if template.name == 'collection' -%}
    <script src="{{ 'gsap-flip.min.js' | asset_url }}" defer></script>
  {%- endif -%}

  {{ content_for_header }}
</head>

{%- liquid
  assign page_kind = template.name
  if template.name == 'index'
    assign page_kind = 'story'
  endif
-%}
<body data-page="{{ page_kind }}" data-template="{{ template | escape }}"{% if template.suffix == 'about' %} class="float"{% endif %}>
  <a class="skip" href="#main">{{ 'general.accessibility.skip_to_content' | t }}</a>

  {% sections 'header-group' %}

  <main id="main" role="main" tabindex="-1">
    {%- comment -%} Shopify writes the policy pages; the theme sets them beside the list of help and policy pages. {%- endcomment -%}
    {%- if is_policy -%}<div class="pol">{% render 'policy-nav' %}<div class="pol-b">{%- endif -%}
    {{ content_for_layout }}
    {%- if is_policy -%}</div></div>{%- endif -%}
  </main>

  {% sections 'footer-group' %}

  {% render 'drawers' %}
</body>
</html>

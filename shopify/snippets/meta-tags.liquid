{%- comment -%}
  The description, robots, Open Graph and Twitter tags. Accepts: description {String} the page's description
  (with the theme's fallback already applied).
{%- endcomment -%}
{%- liquid
  assign og_title = page_title | default: shop.name
  assign og_url = canonical_url | default: request.origin
  assign og_type = 'website'
  assign og_description = description | default: shop.name
  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  endif
  assign share = page_image | default: settings.share_image

  comment
    Search results, the bag and the account pages have nothing for a search engine to list.
  endcomment
  assign noindex = false
  if request.page_type == 'search' or request.page_type == 'cart' or request.page_type == 'captcha' or request.page_type == 'password' or template.directory == 'customers'
    assign noindex = true
  endif
  comment
    Shopify's leftover home page collection, and a blog with nothing in it yet, are not worth a search result either.
  endcomment
  if request.page_type == 'collection' and collection.handle == 'frontpage'
    assign noindex = true
  endif
  if request.page_type == 'blog' and blog.articles_count == 0
    assign noindex = true
  endif
-%}
{%- if og_description != blank -%}
  <meta name="description" content="{{ og_description | strip_html | strip_newlines | escape }}">
{%- endif -%}
{%- if noindex -%}
  <meta name="robots" content="noindex, follow">
{%- else -%}
  <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1">
{%- endif -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:locale" content="{{ request.locale.iso_code | replace: '-', '_' }}">
<meta property="og:url" content="{{ og_url }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:description" content="{{ og_description | strip_html | strip_newlines | escape }}">
{%- if share != blank -%}
  <meta property="og:image" content="https:{{ share | image_url: width: 1200 }}">
  <meta property="og:image:secure_url" content="https:{{ share | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="{{ 1200 | divided_by: share.aspect_ratio | round }}">
  <meta property="og:image:alt" content="{{ share.alt | default: og_title | escape }}">
{%- else -%}
  {%- comment -%} Until a sharing image is set, links show the woodland photograph. {%- endcomment -%}
  <meta property="og:image" content="https:{{ 'photo-hero-forest.jpg' | asset_url }}">
  <meta property="og:image:width" content="1672">
  <meta property="og:image:height" content="941">
  <meta property="og:image:alt" content="{{ shop.name | escape }}">
{%- endif -%}
{%- if request.page_type == 'product' -%}
  <meta property="og:price:amount" content="{{ product.price | money_without_currency | strip_html }}">
  <meta property="og:price:currency" content="{{ cart.currency.iso_code }}">
  <meta property="product:availability" content="{% if product.available %}in stock{% else %}out of stock{% endif %}">
{%- endif -%}
{%- if request.page_type == 'article' -%}
  <meta property="article:published_time" content="{{ article.published_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
  <meta property="article:modified_time" content="{{ article.updated_at | date: '%Y-%m-%dT%H:%M:%S%z' }}">
{%- endif -%}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_description | strip_html | strip_newlines | escape }}">
{%- if settings.social_x != blank -%}
  <meta name="twitter:site" content="@{{ settings.social_x | split: '/' | last | remove: '@' }}">
{%- endif -%}

{%- comment -%}
  A product in the shop grid: the photo blends onto a paper tile, hovering shows the back and adds by size,
  colour dots switch the photo.
  Accepts: product {Object}, from {String} where the quick look says it came from, loading {String}
{%- endcomment -%}
{%- liquid
  assign color_option = nil
  assign size_option = nil
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'color' or oname == 'colour'
      assign color_option = option
    elsif oname == 'size'
      assign size_option = option
    endif
  endfor
  assign title = product.title | remove_first: 'The '
  assign desc = product.description | downcase
  assign img_loading = loading | default: 'lazy'
-%}
<article class="pc" data-handle="{{ product.handle }}" data-price="{{ product.price }}" data-ci="0">
  <div class="pc-im">
    {%- liquid
      if color_option
        assign key = 'option' | append: color_option.position
        assign first_value = color_option.values.first | append: ''
        assign first_variant = product.variants | where: key, first_value | first
        assign front = first_variant.featured_image | default: product.featured_image
        assign value_handle = first_value | handleize
      else
        assign front = product.featured_image
        assign value_handle = ''
      endif
      assign back = nil
      for image in product.images
        assign src = image.src | downcase
        if src contains 'back' and src contains value_handle and image.src != front.src
          assign back = image
          break
        endif
      endfor
    -%}
    <a class="pc-a" href="{{ product.url }}" aria-label="{{ title | escape }}, {{ product.price | money | strip_html }}">
      {%- if front != blank -%}
        {{ front | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 25vw, 50vw', alt: '', class: 'f', loading: img_loading }}
      {%- endif -%}
      {%- if back -%}
        {{ back | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 900px) 25vw, 50vw', alt: '', class: 'b', loading: 'lazy' }}
      {%- endif -%}
    </a>
    {%- if desc contains 'organic' -%}<span class="pc-tag mono">{{ 'products.card.organic' | t }}</span>{%- endif -%}
    {%- if product.available -%}
      <div class="qa">
        {%- if size_option -%}
          <span class="mono">{{ 'products.card.quick_add' | t }}</span>
          <div class="qa-s" role="group" aria-label="{{ 'products.card.quick_add_label' | t: title: title | escape }}">
            {%- for value in size_option.values -%}<button type="button" data-qa="{{ value | escape }}">{{ value | remove: ' cm' }}</button>{%- endfor -%}
          </div>
        {%- else -%}
          <button type="button" class="qa-one" data-qa="">{{ 'products.product.add_to_cart' | t }} {% render 'icon', name: 'plus' %}</button>
        {%- endif -%}
      </div>
    {%- else -%}
      <span class="pc-tag mono pc-out">{{ 'products.product.sold_out' | t }}</span>
    {%- endif -%}
    <button type="button" class="pc-q" data-product="{{ product.handle }}" data-from="{{ from | escape }}" aria-label="{{ 'products.card.quick_look' | t: title: title | escape }}">{% render 'icon', name: 'plus' %}</button>
  </div>
  <div class="pc-m">
    <a href="{{ product.url }}" class="pc-n" tabindex="-1">{{ title }}</a>
    <span class="pc-p">
      {%- if product.price_varies -%}{{ 'products.product.from' | t: price: product.price_min | money }}{%- else -%}{{ product.price | money }}{%- endif -%}
      {%- if product.compare_at_price > product.price %} <s>{{ product.compare_at_price | money }}</s>{% endif -%}
    </span>
    {%- if color_option and color_option.values.size > 1 -%}
      <div class="pc-sw" role="radiogroup" aria-label="{{ title | escape }} {{ color_option.name | downcase }}">
        {%- for value in color_option.values -%}
          {%- liquid
            assign vname = value | append: ''
            assign v_variant = product.variants | where: key, vname | first
            assign v_front = v_variant.featured_image | default: product.featured_image
            assign v_handle = value | handleize
            assign v_back = ''
            for image in product.images
              assign src = image.src | downcase
              if src contains 'back' and src contains v_handle
                assign v_back = image | image_url: width: 900
                break
              endif
            endfor
          -%}
          <button type="button" role="radio" aria-checked="{% if forloop.first %}true{% else %}false{% endif %}" aria-label="{{ value | escape }}" style="--c:{% render 'swatch-color', value: value %}" data-k="{{ forloop.index0 }}" data-value="{{ vname | escape }}" data-front="{{ v_front | image_url: width: 900 }}" data-back="{{ v_back }}"></button>
        {%- endfor -%}
      </div>
      <small class="pc-c">{{ color_option.values.first }} <span>· {{ 'products.card.colours' | t: count: color_option.values.size }}</span></small>
    {%- elsif color_option -%}
      <small class="pc-c">{{ color_option.values.first }}</small>
    {%- endif -%}
  </div>
  <script type="application/json" data-variants>
    {
      "color": {% if color_option %}{{ color_option.position | minus: 1 }}{% else %}null{% endif %},
      "size": {% if size_option %}{{ size_option.position | minus: 1 }}{% else %}null{% endif %},
      "variants": [{% for v in product.variants %}{"id":{{ v.id }},"o":{{ v.options | json }},"a":{{ v.available }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
    }
  </script>
</article>

{%- comment -%} About: questions and answers. {%- endcomment -%}
<section class="ab-faq" id="faq">
  <div><p class="mono">{{ section.settings.label }}</p><h2>{{ section.settings.heading }}</h2></div>
  <div class="faq-l">
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}<i aria-hidden="true"></i></summary><div class="rte">{{ block.settings.answer }}</div></details>
    {%- endfor -%}
  </div>
</section>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {"@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ block.settings.answer | json }}}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "About: questions",
  "class": "section-about-faq",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "Questions" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Asked <em>along the way.</em>" }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "What is Freemorrow?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>An adventure-inspired clothing and accessories brand.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "About: questions" }]
}
{% endschema %}

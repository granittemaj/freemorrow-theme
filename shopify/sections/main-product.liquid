{%- comment -%}
  The product page: the piece on paper with its views, a hang tag with colour, size and Add to bag, the details,
  and photos of it being worn (from the custom.worn_photos metafield, a list of images, when it is set).
  Behaviour: assets/product.js.
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign title = product.title | remove_first: 'The '
  assign main_image = current.featured_image | default: product.featured_image
  assign crumb = collection
  if crumb == blank
    assign crumb = product.collections | where: 'handle', 'shop-all' | first | default: product.collections.first
  endif
  assign worn = product.metafields.custom.worn_photos.value
  assign pair = product.metafields.custom.pairs_with.value
-%}
<nav class="crumb mono" aria-label="{{ 'general.breadcrumb' | t }}">
  <a href="{{ routes.all_products_collection_url }}">{{ 'products.product.shop' | t }}</a>
  {%- if crumb != blank and crumb.handle != 'all' and crumb.handle != 'shop-all' -%}<span>/</span><a href="{{ crumb.url }}">{{ crumb.title }}</a>{%- endif -%}
  <span>/</span><span aria-current="page">{{ title }}</span>
</nav>

<div class="spec" data-product-page>
  <div class="spec-l">
    <div class="surface spec-s">
      <figure class="spec-f">
        {%- if main_image != blank -%}
          {{ main_image | image_url: width: 1400 | image_tag: widths: '600, 900, 1200, 1400', sizes: '(min-width: 900px) 40vw, 80vw', id: 'spImg', alt: product.title, loading: 'eager', fetchpriority: 'high' }}
        {%- endif -%}
      </figure>
      <div class="spec-tools"><div class="seg" role="group" aria-label="{{ 'products.product.views' | t }}" id="spViews"></div><span class="mono" id="spShown"></span></div>
    </div>
    {%- if worn != blank -%}
      <div class="field">
        <p class="mono">{{ 'products.product.worn' | t: count: worn.size }}</p>
        <div class="field-r">
          {%- for img in worn -%}
            <figure>{{ img | image_url: width: 900 | image_tag: widths: '400, 600, 900', sizes: '(min-width: 900px) 20vw, 50vw', alt: img.alt | default: product.title, loading: 'lazy' }}</figure>
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>

  <aside class="spec-r">
    <div class="htag">
      <p class="mono">{% if crumb != blank and crumb.handle != 'all' and crumb.handle != 'shop-all' %}{{ crumb.title }}{% else %}{{ shop.name }}{% endif %}</p>
      <h1>{{ title }}</h1>
      <p class="pr" id="spPrice">{{ current.price | money }}{% if current.compare_at_price > current.price %} <s>{{ current.compare_at_price | money }}</s>{% endif %}</p>

      {%- form 'product', product, id: 'spForm', novalidate: 'novalidate' -%}
        {%- for option in product.options_with_values -%}
          {%- assign option_index = forloop.index0 -%}
          {%- liquid
            assign oname = option.name | downcase
            assign is_color = false
            if oname == 'color' or oname == 'colour'
              assign is_color = true
            endif
          -%}
          {%- if product.has_only_default_variant -%}{%- break -%}{%- endif -%}
          {%- if is_color and option.values.size == 1 -%}
            <p class="mono one">{{ option.name }} · {{ option.selected_value }}</p>
          {%- elsif is_color -%}
            <fieldset class="opt"><legend class="mono">{{ option.name }} <span data-shown="{{ option_index }}">{{ option.selected_value }}</span></legend>
              <div class="sws" role="radiogroup" aria-label="{{ option.name | escape }}">
                {%- for value in option.values -%}
                  <button type="button" class="sw" role="radio" aria-checked="{% if value == option.selected_value %}true{% else %}false{% endif %}" aria-label="{{ value | escape }}" style="--c:{% render 'swatch-color', value: value %}" data-o="{{ option_index }}" data-v="{{ value | escape }}"></button>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- else -%}
            <fieldset class="opt"><legend class="mono">{{ option.name }}</legend>
              <div class="szs" role="radiogroup" aria-label="{{ option.name | escape }}">
                {%- for value in option.values -%}
                  <button type="button" class="sz" role="radio" aria-checked="{% if product.selected_variant and value == option.selected_value %}true{% else %}false{% endif %}" data-o="{{ option_index }}" data-v="{{ value | escape }}">{{ value }}</button>
                {%- endfor -%}
              </div>
              <span class="err" id="spErr" aria-live="polite"></span>
            </fieldset>
          {%- endif -%}
        {%- endfor -%}
        <select name="id" id="spVariant" class="sp-select" aria-label="{{ 'products.product.variant' | t }}">
          {%- for v in product.variants -%}
            <option value="{{ v.id }}"{% if v.id == current.id %} selected{% endif %}{% unless v.available %} disabled{% endunless %}>{{ v.title }} · {{ v.price | money }}</option>
          {%- endfor -%}
        </select>
        <button type="submit" class="btn add-b" id="spAdd"{% unless current.available %} disabled{% endunless %}>
          {%- if current.available -%}{{ 'products.product.add_to_cart' | t }} · {{ current.price | money }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
        </button>
        <small class="mono">{{ 'products.product.taxes' | t }}</small>
      {%- endform -%}
    </div>

    {%- if product.description != blank -%}
      <details open><summary>{{ 'products.product.the_piece' | t }}</summary><div class="rte">{{ product.description }}</div></details>
    {%- endif -%}
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}><summary>{{ block.settings.heading }}</summary><div class="rte">{{ block.settings.text }}</div></details>
    {%- endfor -%}
    {%- if pair != blank -%}
      <a class="pair" href="{{ pair.url }}"><span class="th">{{ pair.featured_image | image_url: width: 160 | image_tag: alt: '', loading: 'lazy' }}</span><span><span class="mono">{{ 'products.product.pairs_with' | t }}</span><b>{{ pair.title | remove_first: 'The ' }}</b><small>{{ pair.price | money }}</small></span>{% render 'icon', name: 'arrow' %}</a>
    {%- endif -%}
  </aside>
</div>
<div class="buybar" inert><span><b>{{ title }}</b><small id="bbNote"></small></span><button type="button" class="btn" id="bbAdd">{{ 'products.product.add_short' | t }} · <span id="bbPrice">{{ current.price | money }}</span></button></div>

<script type="application/json" id="spData">{{ product | json }}</script>
<script src="{{ 'product.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "Product",
  "class": "section-product",
  "blocks": [
    {
      "type": "details",
      "name": "Details panel",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping and returns" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Taxes and shipping are calculated at checkout. Our shipping and refund policies are linked at the foot of every page.</p>" }
      ]
    }
  ]
}
{% endschema %}

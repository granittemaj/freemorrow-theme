{%- comment -%} Choose a password to activate an account. {%- endcomment -%}
<section class="pg pg--narrow">
  <header class="pg-h"><p class="mono">{{ shop.name }}</p><h1>{{ 'customer.activate.title' | t }}</h1></header>
  {%- form 'activate_customer_password', class: 'fm-form' -%}
    {%- if form.errors -%}<div class="errs" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label>{{ 'customer.password' | t }}<input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label>{{ 'customer.password_confirm' | t }}<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button type="submit" class="btn">{{ 'customer.activate.submit' | t }}</button>
    <button type="submit" name="decline" class="tlink">{{ 'customer.activate.decline' | t }}</button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Activate account", "class": "section-activate" }
{% endschema %}

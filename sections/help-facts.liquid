{%- comment -%} Help: the page's title and text, then the essentials as cards (making, delivery, returns, contact). {%- endcomment -%}
<section class="pg pg--wide hp">
  <header class="pg-h">
    <p class="mono">{{ section.settings.eyebrow }}</p>
    <h1>{% if request.page_type == 'page' %}{{ page.title }}{% else %}{{ section.settings.heading }}{% endif %}</h1>
    {%- if section.settings.lede != blank -%}<div class="lede">{{ section.settings.lede }}</div>{%- endif -%}
  </header>
  {%- if request.page_type == 'page' and page.content != blank -%}<div class="rte pg-b">{{ page.content }}</div>{%- endif -%}
  {%- if section.blocks.size > 0 -%}
    <div class="hp-g">
      {%- for block in section.blocks -%}
        <article class="hp-c" {{ block.shopify_attributes }}>
          <p class="mono">{{ block.settings.label }}</p>
          {%- comment -%} An email address stays on one line, sized to fit the card, and opens a new message. {%- endcomment -%}
          {%- if block.settings.heading contains '@' -%}
            <h2 class="hp-mail"><a href="mailto:{{ block.settings.heading | strip }}">{{ block.settings.heading }}</a></h2>
          {%- else -%}
            <h2>{{ block.settings.heading }}</h2>
          {%- endif -%}
          <div class="rte">{{ block.settings.text }}</div>
          {%- if block.settings.link != blank and block.settings.link_label != blank -%}
            <a class="tlink" href="{{ block.settings.link }}">{{ block.settings.link_label }} {% render 'icon', name: 'arrow' %}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Help: essentials",
  "class": "section-help",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Small label", "default": "Help" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Help", "info": "On a page, the page's title is used." },
    { "type": "richtext", "id": "lede", "label": "Introduction" }
  ],
  "blocks": [
    {
      "type": "fact",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "label", "label": "Small label", "default": "Delivery" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "5–9 business days" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Standard delivery within the United States, from the day your order goes to production.</p>" },
        { "type": "text", "id": "link_label", "label": "Link text" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [{ "name": "Help: essentials" }]
}
{% endschema %}

{%- comment -%} The contact page: the page's own text, then Shopify's contact form. {%- endcomment -%}
<section class="pg">
  <header class="pg-h"><p class="mono">{{ section.settings.eyebrow }}</p><h1>{{ page.title }}</h1></header>
  {%- if page.content != blank -%}<div class="rte pg-b">{{ page.content }}</div>{%- endif -%}
  {%- assign help_page = pages['help'] -%}
  {%- if help_page.title != blank -%}<p class="pg-note">{{ 'contact.help_html' | t: url: help_page.url }}</p>{%- endif -%}
  {%- form 'contact', class: 'fm-form pg-b' -%}
    {%- if form.posted_successfully? -%}
      <p class="ok" role="status">{{ 'contact.success' | t }}</p>
    {%- elsif form.errors -%}
      <div class="errs" role="alert">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="row2">
      <label>{{ 'contact.name' | t }}<input type="text" name="contact[name]" autocomplete="name" value="{{ form.name }}"></label>
      <label>{{ 'contact.email' | t }} *<input type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required></label>
    </div>
    <label>{{ 'contact.message' | t }}<textarea name="contact[body]" rows="6">{{ form.body }}</textarea></label>
    <button type="submit" class="btn">{{ 'contact.send' | t }}</button>
  {%- endform -%}
</section>
{% schema %}
{
  "name": "Contact form",
  "class": "section-contact",
  "settings": [{ "type": "text", "id": "eyebrow", "label": "Small label", "default": "Write to us" }]
}
{% endschema %}

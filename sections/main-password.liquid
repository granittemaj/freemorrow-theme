{%- comment -%} The password page, while the shop is closed: the sun below the hills, and a sign-up. {%- endcomment -%}
<section class="pw">
  <div class="sun404">{% render 'sun', id: 'pwSun' %}</div>
  <img class="pw-logo" src="{{ 'logo-white.png' | asset_url }}" alt="{{ shop.name | escape }}" width="90" height="69">
  <h1>{{ section.settings.heading }}</h1>
  {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}
  {%- form 'customer', class: 'ft-n' -%}
    <input type="hidden" name="contact[tags]" value="newsletter">
    {%- if form.posted_successfully? -%}<p role="status">{{ 'newsletter.success' | t }}</p>{%- else -%}
      <div class="ft-in"><input type="email" name="contact[email]" placeholder="{{ 'newsletter.placeholder' | t }}" aria-label="{{ 'newsletter.placeholder' | t }}" autocomplete="email" required><button type="submit">{{ 'newsletter.button' | t }}</button></div>
    {%- endif -%}
  {%- endform -%}
  <details class="pg-more"><summary class="mono">{{ 'password.enter' | t }}</summary>
    {%- form 'storefront_password' -%}
      {%- if form.errors -%}<p role="alert">{{ form.errors | default_errors }}</p>{%- endif -%}
      <div class="ft-in"><input type="password" name="password" aria-label="{{ 'customer.password' | t }}" placeholder="{{ 'customer.password' | t }}"><button type="submit">{{ 'password.submit' | t }}</button></div>
    {%- endform -%}
  </details>
</section>
{% schema %}
{
  "name": "Password page",
  "class": "section-password",
  "settings": [{ "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Tomorrow, <em>freer.</em>" }]
}
{% endschema %}

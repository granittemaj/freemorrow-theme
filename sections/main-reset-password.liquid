{%- comment -%} Choose a new password. {%- endcomment -%}
<section class="pg pg--narrow">
  <header class="pg-h"><p class="mono">{{ shop.name }}</p><h1>{{ 'customer.reset.title' | t }}</h1></header>
  {%- form 'reset_customer_password', class: 'fm-form' -%}
    {%- if form.errors -%}<div class="errs" role="alert">{{ form.errors | default_errors }}</div>{%- endif -%}
    <label>{{ 'customer.password' | t }}<input type="password" name="customer[password]" autocomplete="new-password" required></label>
    <label>{{ 'customer.password_confirm' | t }}<input type="password" name="customer[password_confirmation]" autocomplete="new-password" required></label>
    <button type="submit" class="btn">{{ 'customer.reset.submit' | t }}</button>
  {%- endform -%}
</section>
{% schema %}
{ "name": "Reset password", "class": "section-reset" }
{% endschema %}

{%- comment -%}
  Follow the sun: the home page is one day. A drawn sunrise; the sun opens into the film; the woodland, the terraces
  and the ridge rise one over another with pins on what is worn; a drawn sunset closes it. assets/story.js scrubs it
  with GSAP ScrollTrigger and plays it by itself. The choreography is fixed, so each chapter has its own settings.
{%- endcomment -%}
{%- liquid
  assign s = section.settings
  assign c0 = section.blocks | where: 'type', 'sunrise' | first
  assign c0 = c0.settings
  assign c1 = section.blocks | where: 'type', 'film' | first
  assign c1 = c1.settings
  assign c2 = section.blocks | where: 'type', 'woodland' | first
  assign c2 = c2.settings
  assign c3 = section.blocks | where: 'type', 'terraces' | first
  assign c3 = c3.settings
  assign c4 = section.blocks | where: 'type', 'ridge' | first
  assign c4 = c4.settings
  assign c5 = section.blocks | where: 'type', 'sunset' | first
  assign c5 = c5.settings
  assign chapter_names = c0.name | append: '|' | append: c1.name | append: '|' | append: c2.name | append: '|' | append: c3.name | append: '|' | append: c4.name | append: '|' | append: c5.name | split: '|'
  assign film_src = c1.film_url
  if c1.film != blank
    for source in c1.film.sources
      if source.mime_type == 'video/mp4'
        assign film_src = source.url
      endif
    endfor
  endif
-%}
<section class="story" aria-label="{{ s.label | escape }}">
  <div class="stage">
    <div class="scene sc-film">
      <video muted loop playsinline preload="none" data-src="{{ film_src | escape }}" aria-label="{{ c1.alt | escape }}"
        poster="{% if c1.poster != blank %}{{ c1.poster | image_url: width: 1920 }}{% else %}{{ 'photo-video-poster.jpg' | asset_url }}{% endif %}"></video>
    </div>

    <div class="scene sc-wood">
      <div class="fill" {% render 'photo-size', image: c2.image, fallback: 'hero-forest' %} data-pos="50 40">
        {%- render 'photo', image: c2.image, fallback: 'hero-forest', alt: c2.alt -%}
        {%- if c2.pins -%}
          {%- render 'pin', product: c2.product_1, color: c2.color_1, x: c2.pin_1_x, y: c2.pin_1_y, from: c2.name -%}
          {%- render 'pin', product: c2.product_2, color: c2.color_2, x: c2.pin_2_x, y: c2.pin_2_y, from: c2.name -%}
        {%- endif -%}
      </div>
    </div>

    <div class="scene sc-terr">
      <div class="panel pa">
        <div class="fill" {% render 'photo-size', image: c3.image, fallback: 'life-1' %} data-pos="50 40">
          {%- render 'photo', image: c3.image, fallback: 'life-1', alt: c3.alt, sizes: '(min-width: 760px) 25vw, 45vw' -%}
          {%- if c3.pins -%}{%- render 'pin', product: c3.product_1, color: c3.color_1, x: c3.pin_1_x, y: c3.pin_1_y, from: c3.name -%}{%- endif -%}
        </div>
      </div>
      <div class="panel pb">
        <div class="fill" {% render 'photo-size', image: c3.image_2, fallback: 'life-2' %} data-pos="50 40">
          {%- render 'photo', image: c3.image_2, fallback: 'life-2', alt: c3.alt_2, sizes: '(min-width: 760px) 21vw, 45vw' -%}
        </div>
      </div>
    </div>

    <div class="scene sc-ridge">
      {%- render 'photo', image: c4.image, fallback: 'mountain', alt: c4.alt, class: 'bg' -%}
      <div class="card">
        <div class="fill" {% render 'photo-size', image: c4.print, fallback: 'col-river' %} data-pos="50 30">
          {%- render 'photo', image: c4.print, fallback: 'col-river', alt: c4.print_alt, sizes: '(min-width: 760px) 25vw, 58vw' -%}
          {%- if c4.pins -%}{%- render 'pin', product: c4.product_1, color: c4.color_1, x: c4.pin_1_x, y: c4.pin_1_y, from: c4.name -%}{%- endif -%}
        </div>
      </div>
    </div>

    <div class="dusk" aria-hidden="true"></div>
    <div class="sun">{%- render 'sun', id: 'storySun' -%}</div>
    {%- render 'ridge', class: 'day', back: '#E9C9A4', middle: '#D08B66', front: '#2E4A3B' -%}
    {%- render 'ridge', class: 'night', back: '#33433A', middle: '#26352B', front: '#1C2720' -%}

    <div class="caps">
      <article class="cap" data-cap="0"><p class="mono">{{ c0.name }}</p><h1>{{ c0.heading }}</h1><p class="lead">{{ c0.text }}</p></article>
      <article class="cap" data-cap="1"><p class="mono">{{ c1.name }}</p><h2>{{ c1.heading }}</h2><p class="lead">{{ c1.text }}</p>
        <div class="look">{% render 'chip', product: c1.product_1, color: c1.color_1, from: c1.name %}{% render 'chip', product: c1.product_2, color: c1.color_2, from: c1.name %}</div></article>
      <article class="cap" data-cap="2"><p class="mono">{{ c2.name }}</p><h2>{{ c2.heading }}</h2><p class="lead">{{ c2.text }}</p>
        <div class="look">{% render 'chip', product: c2.product_1, color: c2.color_1, from: c2.name %}{% render 'chip', product: c2.product_2, color: c2.color_2, from: c2.name %}</div></article>
      <article class="cap" data-cap="3"><p class="mono">{{ c3.name }}</p><h2>{{ c3.heading }}</h2><p class="lead">{{ c3.text }}</p>
        <div class="look">{% render 'chip', product: c3.product_1, color: c3.color_1, from: c3.name %}{% render 'chip', product: c3.product_2, color: c3.color_2, from: c3.name %}</div></article>
      <article class="cap" data-cap="4"><p class="mono">{{ c4.name }}</p><h2>{{ c4.heading }}</h2><p class="lead">{{ c4.text }}</p>
        <div class="look">{% render 'chip', product: c4.product_1, color: c4.color_1, from: c4.name %}{% render 'chip', product: c4.product_2, color: c4.color_2, from: c4.name %}</div></article>
      <article class="cap" data-cap="5"><p class="mono">{{ c5.name }}</p><h2>{{ c5.heading }}</h2><p class="lead">{{ c5.text }}</p>
        <div class="acts">
          {%- if c5.button != blank -%}<a class="btn" href="{{ c5.button_link | default: routes.all_products_collection_url }}">{{ c5.button }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
          {%- if c5.link != blank -%}<a class="tlink" href="{{ c5.link_url | default: '/pages/about' }}">{{ c5.link }} {% render 'icon', name: 'arrow' %}</a>{%- endif -%}
        </div></article>
    </div>

    <button type="button" class="cue mono" aria-label="{{ 'story.play' | t }}"><i></i>{{ 'story.scroll' | t }}</button>
    <div class="auto" role="group" aria-label="{{ 'story.autoplay' | t }}">
      <button type="button" class="auto-pp" aria-pressed="false" aria-label="{{ 'story.pause' | t }}" data-pause="{{ 'story.pause' | t | escape }}" data-play="{{ 'story.play_label' | t | escape }}"><svg viewBox="0 0 44 44" aria-hidden="true" focusable="false"><circle class="trk" cx="22" cy="22" r="20"/><circle class="run" cx="22" cy="22" r="20" transform="rotate(-90 22 22)"/><path class="pa" d="M19 16v12M25 16v12"/><path class="pl" d="M19 15.5 29 22l-10 6.5z"/></svg></button>
      <button type="button" class="cue mono" data-go="{{ 'story.go_to' | t | escape }}"><i></i>{{ 'story.scroll' | t }}</button>
    </div>
    <nav class="chap" aria-label="{{ 'story.chapters' | t }}">
      {%- for name in chapter_names -%}<button type="button"><span>{{ name }}</span><i></i></button>{%- endfor -%}
    </nav>
    <div class="bar" aria-hidden="true"><i></i></div>
  </div>
</section>

<script src="{{ 'story.js' | asset_url }}" defer></script>


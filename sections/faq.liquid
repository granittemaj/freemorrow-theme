{%- comment -%}
  Questions and answers, with FAQPage data for search engines and AI assistants.
{%- endcomment -%}
<section class="ab-faq qs" id="{{ section.settings.anchor | default: 'questions' | handleize }}">
  <div>
    <p class="mono">{{ section.settings.label }}</p>
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.text != blank -%}<div class="rte qs-t">{{ section.settings.text }}</div>{%- endif -%}
  </div>
  <div class="faq-l">
    {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}><summary>{{ block.settings.question }}<i aria-hidden="true"></i></summary><div class="rte">{{ block.settings.answer }}</div></details>
    {%- endfor -%}
  </div>
</section>
{%- if section.blocks.size > 0 -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {%- for block in section.blocks -%}
      {"@type": "Question", "name": {{ block.settings.question | json }}, "acceptedAnswer": {"@type": "Answer", "text": {{ block.settings.answer | json }}}}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ]
}
</script>
{%- endif -%}

{% schema %}
{
  "name": "Questions",
  "class": "section-faq",
  "settings": [
    { "type": "text", "id": "label", "label": "Small label", "default": "Questions" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Asked <em>along the way.</em>" },
    { "type": "richtext", "id": "text", "label": "Text" },
    { "type": "text", "id": "anchor", "label": "Anchor", "default": "questions", "info": "Lets a link jump here, e.g. /pages/help#questions." }
  ],
  "blocks": [
    {
      "type": "question",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "Where do you ship?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>Anywhere in the United States.</p>" }
      ]
    }
  ],
  "presets": [{ "name": "Questions" }]
}
{% endschema %}

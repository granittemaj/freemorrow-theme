{%- comment -%} The account: orders and the default address. {%- endcomment -%}
<section class="pg pg--wide">
  <header class="pg-h"><p class="mono">{{ customer.email }}</p><h1>{{ 'customer.account.title' | t }}</h1><a class="tlink" href="{{ routes.account_logout_url }}">{{ 'customer.logout' | t }}</a></header>
  <div class="acct">
    <div>
      <p class="mono">{{ 'customer.account.orders' | t }}</p>
      {%- paginate customer.orders by 20 -%}
        {%- if customer.orders.size > 0 -%}
          <table class="ords"><thead><tr><th>{{ 'customer.order.number' | t }}</th><th>{{ 'customer.order.date' | t }}</th><th>{{ 'customer.order.status' | t }}</th><th>{{ 'customer.order.total' | t }}</th></tr></thead><tbody>
            {%- for order in customer.orders -%}
              <tr><td><a class="tlink" href="{{ order.customer_url }}">{{ order.name }}</a></td><td>{{ order.created_at | date: format: 'abbreviated_date' }}</td><td>{{ order.fulfillment_status_label }}</td><td>{{ order.total_net_amount | money }}</td></tr>
            {%- endfor -%}
          </tbody></table>
        {%- else -%}<p>{{ 'customer.account.none' | t }}</p>{%- endif -%}
      {%- endpaginate -%}
    </div>
    <div>
      <p class="mono">{{ 'customer.account.address' | t }}</p>
      {%- if customer.default_address -%}{{ customer.default_address | format_address }}{%- endif -%}
      <a class="tlink" href="{{ routes.account_addresses_url }}">{{ 'customer.addresses.title' | t }} ({{ customer.addresses_count }})</a>
    </div>
  </div>
</section>
{% schema %}
{ "name": "Account", "class": "section-account" }
{% endschema %}
